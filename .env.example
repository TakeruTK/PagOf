ADMIN_EMAILS=
ADMIN_USERNAME=Admin
# Configure a salted PBKDF2-SHA256 hash server-side; never use a NEXT_PUBLIC_ key.
# Format: pbkdf2-sha256:100000:<32 hex salt chars>:<64 hex hash chars>
ADMIN_PASSWORD_HASH=
# Only set to false for local HTTP development. Omit or set true in production.
SESSION_COOKIE_SECURE=true
