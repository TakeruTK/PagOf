ADMIN_EMAILS=
ADMIN_USERNAME=Admin
# Bootstrap credential only — generate with: node scripts/generate-admin-hash.mjs
# Format: pbkdf2-sha256:<iterations>:<32 hex salt chars>:<64 hex hash chars>
# The workshop owner is required to replace this with her own password on first
# login (stored in D1 from then on); this value only matters until she does.
ADMIN_PASSWORD_HASH=
# Only set to false for local HTTP development. Omit or set true in production.
SESSION_COOKIE_SECURE=true
